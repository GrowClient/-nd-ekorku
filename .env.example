# ---------------------------------------------------------------------------
# barkERP — ortam değişkenleri örneği
#
# Bu dosyayı `.env` olarak kopyalayın ve kendi değerlerinizle doldurun.
# GERÇEK ANAHTARLARI BU DOSYAYA YAZMAYIN — .env dosyası git'e girmez.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Veritabanı ------------------------------------------------------------
# Yerel geliştirme (TCP üzerinden PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barkerp?schema=public"

# Google Cloud SQL for PostgreSQL — ÜRETİM ÖRNEKLERİ
#
# 1) Cloud Run / App Engine (Unix soketi üzerinden, önerilen):
# DATABASE_URL="postgresql://KULLANICI:SIFRE@localhost/VERITABANI?host=/cloudsql/PROJE:BOLGE:ORNEK&schema=public"
#
# 2) Cloud SQL Auth Proxy ile yerelden bağlanma:
# DATABASE_URL="postgresql://KULLANICI:SIFRE@127.0.0.1:5432/VERITABANI?schema=public"
#
# 3) Genel IP + zorunlu SSL:
# DATABASE_URL="postgresql://KULLANICI:SIFRE@IP_ADRESI:5432/VERITABANI?schema=public&sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Oturum jetonlarını imzalayan gizli anahtar. Üretmek için:
#   openssl rand -base64 32
AUTH_SECRET=""

# Uygulamanın dışarıdan erişilen adresi. Yerelde boş bırakılabilir.
# Üretimde MUTLAKA https ile tanımlayın (güvenli çerezler buna göre açılır).
AUTH_URL="http://localhost:3000"

# Şifre yenileme bağlantılarında kullanılan adres.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth ----------------------------------------------------------
# Google Cloud Console > API'ler ve Servisler > Kimlik Bilgileri >
# OAuth 2.0 İstemci Kimliği (Web uygulaması)
#
# Yetkili yönlendirme URI'si olarak şunu ekleyin:
#   http://localhost:3000/api/auth/callback/google        (geliştirme)
#   https://ALAN-ADINIZ/api/auth/callback/google          (üretim)
#
# Bu iki değer boş bırakılırsa "Google ile giriş" butonu görünmez;
# uygulama e-posta + şifre ile sorunsuz çalışmaya devam eder.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
