// ERP çekirdeği — 1. aşama veri modeli
// Bu şema yalnızca kimlik doğrulama ve çok kiracılı (multi-tenant) firma
// yapısını içerir. ERP modülleri sonraki aşamalarda kendi tablolarını
// `organizationId` alanıyla ekleyecektir.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Bir kullanıcının firma içindeki yetkisi. Yeni roller buraya eklenebilir.
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

/// Kiracı (firma / işletme). Tüm ERP verileri ileride bu kayda bağlanacak.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]

  @@map("organizations")
}

/// Uygulama kullanıcısı. Bir kullanıcı birden fazla firmaya üye olabilir.
model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  /// Auth.js'in beklediği görünen ad alanı (ad + soyad).
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Yalnızca e-posta + şifre ile kayıt olanlarda dolu olur (bcrypt hash).
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  memberships         OrganizationMembership[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// Kullanıcı ile firma arasındaki bağ + rol bilgisi.
model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// Auth.js OAuth hesap bağlantısı (Google vb.).
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Auth.js oturum tablosu. Uygulama JWT stratejisi kullandığı için şu anda
/// doldurulmaz; veritabanı oturumlarına geçiş ihtimaline karşı hazır tutulur.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Auth.js doğrulama jetonu (e-posta doğrulama / magic link altyapısı).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Şifre sıfırlama jetonu. Jetonun kendisi değil, SHA-256 özeti saklanır.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
